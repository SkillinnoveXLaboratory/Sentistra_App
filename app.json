{
  "expo": {
    "name": "Sentistra",
    "slug": "Sentistra",
    "version": "1.0.9",
    "orientation": "default",
    "icon": "./assets/images/Launch_Logo_app.png",
    "scheme": "sentistra",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "barStyle": "dark-content"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sentistra.app",
      "versionCode": 10,
      "icon": "./assets/images/Launch_Logo_app.png",
      "googleServicesFile": "./components/google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-launch-logo-adaptive.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app_icon.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sentistra uses your photo library only when you choose a profile photo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Cashfree checkout (SDK classes and its WebView JavaScript bridge)\n-keep class com.cashfree.pg.** { *; }\n-keep class com.reactnativecashfreepgsdk.** { *; }\n-keepclassmembers class * { @android.webkit.JavascriptInterface <methods>; }\n-dontwarn com.cashfree.**"
          }
        }
      ]
    ],
    "extra": {
      "googleWebClientId": "764778624837-642cn1r08i2clu4h2jf9c12etdp67en0.apps.googleusercontent.com"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
